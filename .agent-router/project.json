{
  "v": 1,
  "name": "Usagi",
  "baseBranch": "main",
  "specsDir": "docs/specs",
  "setup": [],
  "verify": [],
  "allowedPaths": [
    "**"
  ],
  "routing": {
    "rules": []
  },
  "worktree": true,
  "specRequired": {
    "sections": [
      "受影响的已有测试"
    ],
    "types": [
      "code",
      "fix",
      "test",
      "refactor"
    ]
  },
  "reportRequired": {
    "sections": [
      "推断清单",
      "TODO(lead)",
      "已知问题"
    ],
    "types": [
      "code",
      "fix",
      "test",
      "refactor"
    ]
  },
  "taskSlots": {
    "weight": 8,
    "min": 3
  },
  "fullVerify": [
    "npm --prefix app ci",
    "npm --prefix app run typecheck",
    "npm --prefix app test",
    "npm --prefix app run smoke",
    "sh pipeline/run_tests.sh"
  ],
  "push": {
    "allowLead": true
  }
}
